{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariants.invalid/schema/invariant-v0.1.json",
  "title": "Invariant rule file (spec invariant/v0.1)",
  "description": "Structural schema for the rule file. The loader also runs checks a schema cannot express: targets and providers resolve, provider signatures and return types, args paths against target signatures, status supported by evidence, artifact hashes, model policy against the schema type.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spec": {"enum": ["invariant/v0.1"]},
    "contracts": {"type": "object", "additionalProperties": {"type": "object"}},
    "targets": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/target"}},
    "providers": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/provider"}},
    "rules": {"type": ["array", "null"], "items": {"$ref": "#/$defs/rule"}},
    "allow_unresolved": {"$ref": "#/$defs/sharedAllowUnresolved",
                         "description": "Reviewed unresolved sites, each accepted under every path law its rules list (once under each). Expands into each listed rule's mediation.allow_unresolved."}
  },
  "$defs": {
    "pyRefs": {"oneOf": [{"type": "string", "pattern": "^py:"}, {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^py:"}}]},
    "allowUnresolved": {"oneOf": [{"type": "null"}, {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["at", "code", "sha", "why"],
      "properties": {
        "at": {"type": "string", "pattern": "^[^:]+:[1-9][0-9]*(:[1-9][0-9]*)?$", "description": "path:line or path:line:col, the file relative to its source root as the scan reports it"},
        "code": {"type": "string", "pattern": "^unresolved/", "description": "the finding's code; only unresolved findings can be accepted"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "the sha the scan gives the finding (inv scan --format json)"},
        "why": {"type": "string", "minLength": 1, "description": "why the reviewed site cannot reach the sink"},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "set when the entry comes from the file's top-level allow_unresolved: every rule it is accepted under"}}}}]},
    "sharedAllowUnresolved": {"oneOf": [{"type": "null"}, {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["at", "code", "sha", "why", "rules"],
      "properties": {
        "at": {"type": "string", "pattern": "^[^:]+:[1-9][0-9]*(:[1-9][0-9]*)?$", "description": "path:line or path:line:col, the file relative to its source root as the scan reports it"},
        "code": {"type": "string", "pattern": "^unresolved/", "description": "the finding's code; only unresolved findings can be accepted"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "the sha the scan gives the finding (inv scan --format json)"},
        "why": {"type": "string", "minLength": 1, "description": "why the reviewed site cannot reach any of the rules' sinks"},
        "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}, "description": "the path laws (rule ids) the site is accepted under, once under each"}}}}]},
    "sinkPairs": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^py:"}, "additionalProperties": {"$ref": "#/$defs/pyRefs"},
                  "description": "Each sink mapped to the door or doors that may reach it: a door listed for one sink is no door for another."},
    "sinks": {"oneOf": [{"$ref": "#/$defs/pyRefs"}, {"$ref": "#/$defs/sinkPairs"}]},
    "path": {"type": "string", "pattern": "^((args|result|reply|self|old_self)(\\.[A-Za-z_][A-Za-z0-9_]*)*|provider\\.[A-Za-z_][A-Za-z0-9_]*)$",
             "description": "A root (args, result, reply, self, old_self) and a field path, or provider.<name> (a declared provider, nothing after it)."},
    "nameMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/path"}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects"],
      "properties": {
        "effects": {"enum": ["none", "external"]}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "args"],
      "properties": {
        "type": {"type": "string"},
        "from": {"type": "string", "pattern": "^py:"},
        "args": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                                                             "description": "A path from a root (args, result, reply, self, old_self) or a name the rule binds, e.g. args.account."}},
        "concurrent": {"type": "boolean", "description": "an async provider that may be awaited alongside other opted-in ones (default false: one at a time, in order)"}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when"],
      "properties": {
        "when": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "enforcer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "timing", "mode"],
      "properties": {
        "point": {"enum": ["type", "gateway", "decorator", "middleware", "model_call", "edge", "build",
                           "structure", "monitor"]},
        "target": {"type": "string", "pattern": "^py:"},
        "timing": {"enum": ["pre_effect", "post_effect"]},
        "mode": {"enum": ["off", "detect", "enforce"]},
        "on_violation": {"enum": ["reject", "halt", "escalate", "route"]},
        "on_error": {"enum": ["fail_closed", "fail_open_and_page"]},
        "view": {"$ref": "#/$defs/nameMap"},
        "artifact": {"type": "string"},
        "generated": {"type": "boolean"},
        "conformance_test": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"point": {"const": "edge"}}},
         "then": {"required": ["target"]},
         "else": {"not": {"required": ["target"]}}},
        {"if": {"properties": {"view": {"type": "object"}}, "required": ["view"]},
         "then": {"properties": {"point": {"enum": ["decorator", "middleware", "model_call", "edge", "monitor"]}}}}
      ]
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {"type": "string"},
        "format_retries": {"type": "integer", "minimum": 0},
        "semantic_resamples": {"type": "integer", "minimum": 0},
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {"enum": ["parser_error", "none"]},
            "semantic": {"const": "none"}
          }
        },
        "abstain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "value"],
          "properties": {"field": {"type": "string"}, "value": {}}
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
               "description": "Letters, digits, -, _ and ., starting with a letter or digit (no spaces)."},
        "guard": {"type": "string", "pattern": "^py:",
                  "description": "Short form: the function this rule guards. Expands to subject.target and one decorator enforcer (pre_effect, mode enforce); status defaults to enforce with tests, else detect."},
        "tests": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}],
                  "description": "Short form of falsified_by: the tests that must fail when the rule is switched off."},
        "door": {"$ref": "#/$defs/pyRefs",
                 "description": "Door rule: the function(s) every write to the sink must go through. Expands to mediation.door; checked by inv scan, nothing runs in production."},
        "sink": {"$ref": "#/$defs/sinks", "description": "Door rule: the function(s) that write, or a mapping from each to the door(s) that may reach it (then door: is left out or names the same doors). Expands to mediation.sink."},
        "allow": {"oneOf": [{"$ref": "#/$defs/pyRefs"}, {"type": "null"}, {"type": "array", "maxItems": 0}],
                  "description": "Door rule: known back doors, frozen (empty or null: none left). Each may keep its own path to the sink; a new caller that reaches the sink through one is still a back door. Adding one is a weakening."},
        "allow_unresolved": {"$ref": "#/$defs/allowUnresolved",
                             "description": "Door rule: unresolved findings a person reviewed and accepts, one site each. Expands to mediation.allow_unresolved. Adding or widening one is a weakening."},
        "rev": {"type": "integer"},
        "status": {"enum": ["candidate", "contested", "detect", "enforce", "retired"]},
        "class": {"enum": ["law", "policy"]},
        "owner": {"type": "string"},
        "statement": {"type": "string"},
        "why": {"type": "string"},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"contract": {"type": "string"}, "target": {"type": "string", "pattern": "^py:"},
                         "operation": {"type": "string", "description": "The OpenAPI operation the rule binds to (an operationId, or METHOD /path); overrides the contract's operation."}}
        },
        "scope": {"type": "string"},
        "bind": {"$ref": "#/$defs/nameMap"},
        "bad": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}}]},
        "compensable": {"type": "boolean"},
        "enforcers": {"type": "array", "items": {"$ref": "#/$defs/enforcer"}},
        "mediation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chokepoint": {"type": "string"},
            "residual_paths": {"type": "array", "items": {"type": "string"}},
            "sink": {"$ref": "#/$defs/sinks"},
            "door": {"$ref": "#/$defs/pyRefs"},
            "allow": {"$ref": "#/$defs/pyRefs"},
            "allow_unresolved": {"$ref": "#/$defs/allowUnresolved"}
          }
        },
        "model_policy": {"$ref": "#/$defs/modelPolicy"},
        "compares_to": {"const": "held_data"},
        "falsified_by": {"type": "array", "items": {"type": "string"}},
        "evidence": {},
        "applies_to": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]}
      },
      "allOf": [
        {"if": {"properties": {"compares_to": {"const": "held_data"}, "model_policy": {"type": "object"}},
                "required": ["compares_to", "model_policy"]},
         "then": {"properties": {"model_policy": {"properties": {"semantic_resamples": {"const": 0}}}}}},
        {"if": {"not": {"anyOf": [{"required": ["guard"]}, {"required": ["sink"]}]}}, "then": {"required": ["status"]}},
        {"if": {"not": {"required": ["sink"]}}, "then": {"required": ["bad"]}}
      ]
    }
  }
}
